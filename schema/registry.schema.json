{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purplefusion.com.au/schemas/msp-mcp-registry/v1",
  "title": "PurpleFusion MSP MCP Registry",
  "type": "object",
  "required": ["schemaVersion", "serial", "updated", "reviewers", "servers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "serial": { "type": "integer", "description": "Goes up by one every time the registry is signed. Tabby9 refuses a copy with a lower serial than one it has seen, so an old signed copy can't be replayed." },
    "updated": { "type": "string", "format": "date" },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "org": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "github": { "type": "string" }
        }
      }
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "vendor", "category", "tier", "install", "credentials", "scope", "maintainer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable id, also the Claude Code MCP server name" },
        "name": { "type": "string" },
        "vendor": { "type": "string", "description": "The product this connects to, e.g. HaloPSA" },
        "category": { "enum": ["psa", "rmm", "documentation", "security", "backup", "m365", "distribution", "accounting", "crm", "network", "other"] },
        "description": { "type": "string", "maxLength": 200 },
        "tier": {
          "enum": ["vendor-verified", "reviewed", "assessed", "listed"],
          "description": "vendor-verified: published or endorsed by the product vendor. reviewed: a named reviewer read and ran the pinned version against REVIEW-CHECKLIST.md. assessed: the pinned version's source and release were scored against ASSESSMENT.md, nothing run. listed: exists, not reviewed."
        },
        "maintainer": {
          "type": "object",
          "required": ["name", "url"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "vendorOfficial": { "type": "boolean", "default": false }
          }
        },
        "install": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["claude-plugin", "npx", "uvx", "remote-http", "docker", "binary"], "description": "binary: prebuilt files described in server.files" },
            "marketplace": { "type": "string", "description": "claude-plugin: owner/repo of the marketplace" },
            "plugin": { "type": "string", "description": "claude-plugin: plugin name within the marketplace" },
            "package": { "type": "string", "description": "npx/uvx: package name" },
            "url": { "type": "string", "format": "uri", "description": "remote-http: server URL" },
            "image": { "type": "string", "description": "docker: image reference" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "server": {
          "type": "object",
          "description": "The MCP server itself, which a plugin may not contain. Tabby9 writes this entry into Claude Code's config, wrapped by its launcher. Without it, Tabby9 shows the entry but offers no install.",
          "required": ["transport"],
          "additionalProperties": false,
          "properties": {
            "transport": { "enum": ["stdio", "http"] },
            "url": { "type": "string", "format": "uri", "description": "http: the endpoint" },
            "hostedBy": { "type": "string", "description": "http: who runs the endpoint. Credentials sent to it leave the user's machine." },
            "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "http: header name to value; ${ENV} refers to a credentials[] entry" },
            "runtime": { "enum": ["npx", "uvx", "binary", "docker"], "description": "stdio: how the server is started" },
            "package": { "type": "string", "description": "npx/uvx: package name" },
            "version": { "type": "string", "description": "npx/uvx: exact version" },
            "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$", "description": "docker: image pinned by digest" },
            "files": {
              "type": "array",
              "description": "binary: files Tabby9 downloads into one folder, checks against sha256, and puts first on the server's PATH",
              "items": {
                "type": "object",
                "required": ["name", "url", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "File name to save as" },
                  "url": { "type": "string", "format": "uri" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "platform": { "enum": ["win32-x64", "win32-arm64"] }
                }
              }
            },
            "command": { "type": "string", "description": "binary: which of files[] to run" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Fixed, non-secret environment values" }
          }
        },
        "pin": {
          "type": "object",
          "description": "The exact version a review applies to. Required for tier reviewed and vendor-verified.",
          "required": ["version"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the published tarball, if applicable" },
            "pinnedOn": { "type": "string", "format": "date" }
          }
        },
        "credentials": {
          "type": "array",
          "description": "Secrets the server needs. Tabby9 stores these in Windows Credential Manager and injects as env vars.",
          "items": {
            "type": "object",
            "required": ["env", "label", "type"],
            "additionalProperties": false,
            "properties": {
              "env": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "label": { "type": "string" },
              "type": { "enum": ["api-key", "oauth-client-id", "oauth-client-secret", "username", "password", "url", "tenant-id", "token", "other"] },
              "secret": { "type": "boolean", "default": true },
              "help": { "type": "string", "description": "Where in the vendor UI to generate this" },
              "leastPrivilege": { "type": "string", "description": "The minimum role/permission set to grant" }
            }
          }
        },
        "scope": {
          "type": "object",
          "required": ["reads", "writes", "touchesSecrets"],
          "additionalProperties": false,
          "properties": {
            "reads": { "type": "array", "items": { "type": "string" }, "description": "Plain-English list of what it can read" },
            "writes": { "type": "array", "items": { "type": "string" }, "description": "Plain-English list of what it can create/change/delete" },
            "touchesSecrets": { "type": "boolean", "description": "true if any tool can return stored passwords, keys or similar" },
            "readOnlyMode": {
              "type": "object",
              "description": "How to run it read-only, if supported",
              "additionalProperties": false,
              "properties": {
                "supported": { "type": "boolean" },
                "env": { "type": "string" },
                "value": { "type": "string" },
                "denyTools": { "type": "array", "items": { "type": "string" }, "description": "Tool names Tabby9 should deny if the server has no native read-only switch" }
              }
            },
            "multiTenant": { "type": "boolean", "description": "true if it can reach more than one client/tenant" }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoints": { "type": "array", "items": { "type": "string" }, "description": "Hosts it talks to, from code review" },
            "telemetry": { "type": "boolean", "description": "true if it phones home to anyone other than the vendor API" }
          }
        },
        "review": {
          "type": "object",
          "required": ["reviewer", "date", "report"],
          "additionalProperties": false,
          "properties": {
            "reviewer": { "type": "string", "description": "reviewer id" },
            "date": { "type": "string", "format": "date" },
            "report": { "type": "string", "description": "Path to the review markdown, e.g. reviews/halopsa.md" },
            "notes": { "type": "string" },
            "expires": { "type": "string", "format": "date", "description": "Re-review due; Tabby9 shows a stale badge after this" }
          }
        },
        "assessment": {
          "type": "object",
          "description": "A desk assessment (ASSESSMENT.md) of the pinned version. Required for tier assessed; allowed on any tier.",
          "required": ["by", "date", "score", "report"],
          "additionalProperties": false,
          "properties": {
            "by": { "type": "string", "description": "reviewer id of the person who checked the flags" },
            "date": { "type": "string", "format": "date" },
            "score": { "type": "integer", "description": "0 to 100, after caps" },
            "caps": { "type": "array", "items": { "type": "string" }, "description": "Caps applied, in plain words" },
            "report": { "type": "string", "description": "Path to the report, e.g. assess/reports/connectwise-psa/mspstack-connectwise-psa.md" },
            "group": { "type": "string", "description": "The ranking it belongs to, e.g. connectwise-psa (assess/reports/<group>/RANKING.md)" },
            "rank": { "type": "integer", "description": "Its place in that ranking when assessed" },
            "of": { "type": "integer", "description": "How many servers were ranked" }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "format": "uri" },
            "docs": { "type": "string", "format": "uri" },
            "issues": { "type": "string", "format": "uri" },
            "vendorDocs": { "type": "string", "format": "uri" }
          }
        },
        "warnings": {
          "type": "array",
          "description": "Facts about risk to the user, each with its source. Severity levels are defined in README.md.",
          "items": {
            "type": "object",
            "required": ["severity", "risk", "detail"],
            "additionalProperties": false,
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
              "risk": { "type": "string", "maxLength": 80, "description": "The risk in a few words" },
              "detail": { "type": "string", "maxLength": 400, "description": "What the server does, what could go wrong, and what to do about it. Facts only." },
              "source": { "type": "string", "format": "uri", "description": "Where the fact comes from: the maintainer's docs or code" }
            }
          }
        },
        "deprecated": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "enum": ["reviewed", "vendor-verified", "assessed"] } } },
          "then": { "required": ["pin"] }
        },
        {
          "if": { "properties": { "tier": { "const": "assessed" } } },
          "then": { "required": ["assessment"] }
        },
        {
          "if": { "properties": { "tier": { "const": "reviewed" } } },
          "then": { "required": ["review"] }
        }
      ]
    }
  }
}
