      "id": "halopsa",
      "name": "HaloPSA",
      "vendor": "HaloPSA",
      "category": "psa",
      "description": "Tickets, clients, assets, agents, contracts and invoices in HaloPSA.",
      "tier": "listed",
      "maintainer": {
        "name": "WYRE Technology",
        "url": "https://github.com/WYRE-AI"
      },
      "install": {
        "method": "claude-plugin",
        "marketplace": "WYRE-AI/msp-claude-plugins",
        "plugin": "halopsa"
      },
      "credentials": [
        {
          "env": "HALOPSA_URL",
          "label": "HaloPSA URL",
          "type": "url",
          "secret": false,
          "help": "Your tenant URL, e.g. https://yourmsp.halopsa.com"
        },
        {
          "env": "HALOPSA_CLIENT_ID",
          "label": "OAuth client ID",
          "type": "oauth-client-id",
          "secret": false,
          "help": "Config > Integrations > HaloPSA API > Applications"
        },
        {
          "env": "HALOPSA_CLIENT_SECRET",
          "label": "OAuth client secret",
          "type": "oauth-client-secret",
          "help": "Same screen. Use Client Credentials, not Resource Owner.",
          "leastPrivilege": "Create a dedicated API agent with read:tickets, read:customers; add write permissions only if you enable writes"
        }
      ],
      "scope": {
        "reads": [
          "Tickets and actions",
          "Clients and sites",
          "Assets",
          "Agents",
          "Contracts",
          "Invoices"
        ],
        "writes": [
          "Create and update tickets",
          "Add ticket actions and time",
          "Update assets"
        ],
        "touchesSecrets": false,
        "multiTenant": true,
        "readOnlyMode": {
          "supported": false,
          "denyTools": [
            "create_*",
            "update_*",
            "delete_*",
            "add_*"
          ]
        }
      },
      "links": {
        "source": "https://github.com/WYRE-AI/msp-claude-plugins",
        "docs": "https://mcp.wyre.ai/mcp-servers/"
      },
      "warnings": [
        "Marked beta by its maintainer."
      ]
