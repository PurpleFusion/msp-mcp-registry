    {
      "id": "pax8",
      "name": "Pax8",
      "vendor": "Pax8",
      "category": "distribution",
      "description": "Pax8 marketplace: subscriptions, products, companies and billing, via Pax8's official hosted MCP server.",
      "tier": "listed",
      "maintainer": {
        "name": "Pax8",
        "url": "https://www.pax8.com",
        "vendorOfficial": true
      },
      "install": {
        "method": "claude-plugin",
        "marketplace": "WYRE-AI/msp-claude-plugins",
        "plugin": "pax8"
      },
      "credentials": [
        {
          "env": "PAX8_MCP_TOKEN",
          "label": "Pax8 MCP token",
          "type": "token",
          "help": "Generated in the Pax8 Platform under integrations",
          "leastPrivilege": "Read-only token unless you need ordering"
        }
      ],
      "scope": {
        "reads": [
          "Companies",
          "Subscriptions",
          "Products and pricing",
          "Invoices"
        ],
        "writes": [
          "Subscription changes (if the token allows)"
        ],
        "touchesSecrets": false,
        "multiTenant": true,
        "readOnlyMode": {
          "supported": true,
          "denyTools": [],
          "env": "PAX8_MCP_TOKEN",
          "value": "(issue a read-only token in the Pax8 Platform)"
        }
      },
      "links": {
        "source": "https://github.com/WYRE-AI/msp-claude-plugins"
      },
      "warnings": [
        "Vendor-hosted: your data goes to Pax8's MCP endpoint. Promote to vendor-verified once Pax8's own docs page is confirmed and pinned."
      ]
    },
